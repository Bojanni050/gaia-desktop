{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gaia",
  "version": "0.1.0",
  "identifier": "ai.gaia.desktop",
  "build": {
    "frontendDist": "../desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ./desktop run dev",
    "beforeBuildCommand": "npm --prefix ./desktop run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gaia",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Bojanni050/gaia-desktop/releases/latest/download"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
